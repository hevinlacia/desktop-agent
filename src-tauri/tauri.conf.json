{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Agent",
  "version": "0.1.0",
  "identifier": "dev.hevin.desktop-agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Desktop Agent",
        "width": 720,
        "height": 132,
        "minWidth": 420,
        "minHeight": 56,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": false,
        "visible": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "个人桌面 AI Agent 客户端",
    "longDescription": "轻量级桌面 AI Agent 客户端：KDE Wayland 原生快捷键唤起、流式对话、工具调用可视化。后端通过适配器对接 pi agent。"
  }
}
